# gnet-console SaaS runtime — `/apps/gnet/.env` on t01.
#
# Loaded automatically by `docker compose` from the same directory
# as `docker-compose.yml`. NEVER commit a filled copy of this file;
# the deploy pipeline materialises the real values from the devops
# secret store at deploy time. `.gitignore` excludes `.env`.
#
# This file lives at the repo ROOT because docker compose only
# auto-discovers `.env` next to the compose file. `.env.local` would
# need an explicit `--env-file` on every compose call, which the
# devops deploy pipeline doesn't pass.

# ──────────────────────────────────────────────────────────────────
# Postgres (docker-compose-internal)
# ──────────────────────────────────────────────────────────────────

# Strong password for the in-compose `postgres` service. Generate
# one fresh per install — anything 20+ random chars is fine.
#   openssl rand -base64 24
# The compose file builds `GNET_CONSOLE_DATABASE_URL` from this
# value (so it stays in lockstep with the postgres container's
# POSTGRES_PASSWORD); no separate DATABASE_URL line is needed here.
POSTGRES_PASSWORD=

# ──────────────────────────────────────────────────────────────────
# Federation secret (binds federation tokens to this console)
# ──────────────────────────────────────────────────────────────────

# 64-char hex (32 bytes). Rotating this invalidates EVERY federation
# token in flight — generate once at install, persist forever.
#   openssl rand -hex 32
GNET_CONSOLE_FEDERATION_SECRET=

# ──────────────────────────────────────────────────────────────────
# Public origin
# ──────────────────────────────────────────────────────────────────

# Override the default `https://gnet.golia.jp` only for non-prod
# deployments. The console uses this to build OAuth redirect URIs.
# GNET_CONSOLE_PUBLIC_URL=

# ──────────────────────────────────────────────────────────────────
# OAuth providers (plan §6.2)
# ──────────────────────────────────────────────────────────────────

# Leave blank to disable a provider; the binary warns at startup.

# Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple — client_id is the Service ID; we sign the JWT client_secret
# on the fly per Apple Sign-In (plan §17.5d). The private-key .p8
# path must be inside the container; mount it via the compose file
# if you enable Apple sign-in.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_PRIVATE_KEY_PATH=

# ──────────────────────────────────────────────────────────────────
# Email transport (plan §6.6)
# ──────────────────────────────────────────────────────────────────

# Unset → console auto-verifies new signups WITHOUT a mail loop.
# Set both → console queues verification mails via mailrs.
MAILRS_SMTP_HOST=
MAILRS_SMTP_PORT=

# ──────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────

# `info,sqlx=warn` is sane in prod; bump to `gnet_console=debug`
# when investigating an issue. Avoid `trace` on a live deployment.
RUST_LOG=info,sqlx=warn
