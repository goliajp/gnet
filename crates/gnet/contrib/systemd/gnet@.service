# gnet overlay daemon (Linux, systemd template unit).
#
# Install one instance:
#   sudo install -d -m 0755 /etc/gnet /var/log/gnet
#   sudo install -m 0600 main.conf            /etc/gnet/<instance>.conf
#   sudo install -m 0755 target/release/gnet  /usr/local/bin/gnet
#   sudo install -m 0644 gnet@.service        /etc/systemd/system/gnet@.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gnet@<instance>
#
# %i in this template expands to <instance>, so `gnet@main` loads
# /etc/gnet/main.conf, `gnet@home` loads /etc/gnet/home.conf, etc.
#
# Tail logs:   journalctl -u gnet@<instance> -f
# Status:      systemctl status gnet@<instance>
# Stop / off:  systemctl disable --now gnet@<instance>
#
# tun0 is owned by this fd (IFF_TUN, no IFF_PERSIST); kernel destroys
# the interface when the process exits. No PID file, no cleanup hook.

[Unit]
Description=gnet overlay daemon (%i)
Documentation=https://github.com/goliajp/gnet
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/gnet/%i.conf

[Service]
Type=simple
ExecStart=/usr/local/bin/gnet up /etc/gnet/%i.conf

# Lifecycle: SIGTERM the main process, give it 10s to close the tun fd,
# then SIGKILL the whole cgroup. Restart only on failure (status != 0).
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=10s

# Hardening — daemon still needs root + CAP_NET_ADMIN + /dev/net/tun, so
# PrivateDevices and DynamicUser are not compatible. The rest of the sandbox
# was verified on Debian 13 + kernel 6.12 (v0.14): daemon starts, opens the
# tun fd, runs the UDP socket loop, ip-route configures the overlay, all
# under these flags.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/gnet
# Admin IPC unix socket — systemd materialises /run/gnet/ (0755, root-owned)
# on start and removes it on stop, so the daemon can bind admin.sock without
# punching a hole in ProtectSystem=strict. /var/run -> /run symlink on Debian
# 13 makes the daemon-side path (/var/run/gnet/admin.sock) resolve here.
RuntimeDirectory=gnet
RuntimeDirectoryMode=0755
ProtectHome=true
PrivateTmp=true
LockPersonality=true
RestrictNamespaces=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
# AF_INET/INET6 for the UDP socket and curl (HTTP coordinator), AF_NETLINK
# for the `ip addr add` / `ip link set` calls used to configure the tun,
# AF_UNIX for the admin IPC socket (v0.21).
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# Bandwidth accounting — systemctl show exposes IPIngressBytes/IPEgressBytes
# so operators can see per-instance traffic without external probes.
IPAccounting=true

[Install]
WantedBy=multi-user.target
