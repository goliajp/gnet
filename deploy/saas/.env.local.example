# gnet-console SaaS runtime config — t01 `/apps/gnet-console/.env.local`.
#
# Loaded by the systemd unit via `EnvironmentFile=`. NEVER commit a
# filled copy of this file; the deploy pipeline materialises the
# real values from the devops secret store at deploy time.

# ──────────────────────────────────────────────────────────────────
# Bind + PG + Valkey (on-box)
# ──────────────────────────────────────────────────────────────────

# Loopback bind — Caddy reverse-proxies from gnet.golia.jp. 6015 is
# the port reserved for the console binary across dev + prod; if you
# change it, update deploy/saas/services.json and caddy-site.json to
# match.
GNET_CONSOLE_BIND=127.0.0.1:6015

# Public origin Caddy serves. The console uses this to build OAuth
# redirect URIs and federation handshake callbacks; the apex must
# match the apex DNS record (deploy/saas/dns-apex.json).
GNET_CONSOLE_PUBLIC_URL=https://gnet.golia.jp

# Postgres on t01 (systemd unit, not docker). Plan §10.2: PG18 +
# Valkey 9 run as systemd services on t01.
GNET_CONSOLE_DATABASE_URL=postgres://gnet_console:CHANGEME@127.0.0.1/gnet_console

# Valkey on t01.
GNET_CONSOLE_VALKEY_URL=redis://127.0.0.1:6379

# ──────────────────────────────────────────────────────────────────
# Federation secret (binds federation tokens to this console)
# ──────────────────────────────────────────────────────────────────

# 64-char hex (32 bytes). Rotating this invalidates EVERY federation
# token in flight — generate once at install, persist.
#   openssl rand -hex 32
GNET_CONSOLE_FEDERATION_SECRET=

# ──────────────────────────────────────────────────────────────────
# OAuth providers (plan §6.2)
# ──────────────────────────────────────────────────────────────────

# Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple — client_id is the Service ID; client_secret is path to the
# .p8 private key, NOT the key contents. The console signs the JWT
# client_secret on the fly per the Apple Sign-In wire (plan §17.5d).
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_PRIVATE_KEY_PATH=

# ──────────────────────────────────────────────────────────────────
# Email transport (plan §6.6)
# ──────────────────────────────────────────────────────────────────

# Unset → console auto-verifies new signups WITHOUT a mail loop.
# Set both → console queues verification mails via mailrs.
MAILRS_SMTP_HOST=
MAILRS_SMTP_PORT=

# ──────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────

# `info` is sane in prod; bump to `gnet_console=debug,sqlx=warn`
# when investigating an issue. Avoid `trace` on a live deployment —
# log volume goes up by ~100×.
RUST_LOG=info,sqlx=warn
