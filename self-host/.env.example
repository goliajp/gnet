# gnet v1.1 self-host — .env template.
#
# Copy to `.env`, fill in real values, then `docker compose up -d`.
# This file is the only place secrets live; the compose YAML reads
# them via ${VAR:?...} so missing values are caught at startup
# instead of producing a half-broken stack.

# ──────────────────────────────────────────────────────────────────
# Postgres
# ──────────────────────────────────────────────────────────────────

# Strong password for the `gnet` PG user. Generate one fresh per
# install — anything 20+ random chars is fine. Example:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ──────────────────────────────────────────────────────────────────
# Dispatcher
# ──────────────────────────────────────────────────────────────────

# Bearer token presented by the daemon's `/endpoint-report` etc.
# Must be at least 16 characters. The dispatcher refuses to start
# below that. Generate fresh:
#   openssl rand -hex 24
DISPATCHER_ADMIN_TOKEN=

# Host ports the dispatcher exposes. The defaults match plan §10.1
# (8765 admin, 65432 v1.0 coord) — override if those collide with
# something else on this host.
DISPATCHER_ADMIN_PORT=8765
DISPATCHER_COORD_PORT=65432

# ──────────────────────────────────────────────────────────────────
# Relay
# ──────────────────────────────────────────────────────────────────

# Bearer for the relay's lite admin HTTP surface (/api/peers,
# /api/traffic). Same 16-char minimum.
RELAY_ADMIN_TOKEN=

# Host ports the relay exposes.
RELAY_PORT=65433
RELAY_ADMIN_PORT=8766

# Public endpoint the dispatcher advertises to daemons for this
# relay. Daemons connect to this address when their direct path
# fails, so it must be the address THEY see, not the docker network
# alias. For a single-host self-install on a LAN box, set this to
# the host's LAN IP + RELAY_PORT, e.g. `192.168.1.10:65433`. For a
# public deployment, the public IP + public RELAY_PORT.
RELAY_ADVERTISED_ENDPOINT=

# ──────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────

# `tracing` env-filter. `info` is a sane default; bump to
# `gnet_discover=debug,gnet_relay_server=debug` for noisier output
# when investigating an issue.
RUST_LOG=info
